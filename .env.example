MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/nazarene-church?retryWrites=true&w=majority
NEXTAUTH_URL=http://localhost:3001
NEXTAUTH_SECRET=generate-a-unique-random-value-at-least-32-characters

# Only needed to create the first administrator with `npm run seed`
ADMIN_EMAIL=admin@example.org
ADMIN_PASSWORD=choose-a-unique-password-at-least-12-characters
ADMIN_NAME=Church Administrator

# Comma-separated admin account emails allowed to read/manage pastoral prayer requests.
# Leave blank to deny access until the pastoral team accounts are confirmed.
PASTORAL_TEAM_EMAILS=
